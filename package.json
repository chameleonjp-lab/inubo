{
  "name": "inubo",
  "private": true,
  "version": "0.1.0",
  "description": "犬のスケボー（イヌボー）: 犬そのものをスケートボードに見立てて街を滑るブラウザゲーム",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "report": "REPORT_OUT=docs/autoplay-report.md vitest run tests/report.test.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
